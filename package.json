{
  "name": "meditracker-pro-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:test": "cross-env NODE_ENV=test next dev",
    "dev:prod": "cross-env NODE_ENV=production next dev",
    "check-env": "node -e \"console.log('NODE_ENV:', process.env.NODE_ENV || 'development')\"",
    "build": "next build",
    "start": "next start",
    "start:prod": "cross-env NODE_ENV=production next start",
    "prod": "cross-env NODE_ENV=production npm run build && npm run start:prod",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest -c app/__tests__/config/jest.config.js",
    "test:watch": "jest -c app/__tests__/config/jest.config.js --watch",
    "test:coverage": "jest -c app/__tests__/config/jest.config.js --coverage",
    "test:ci": "jest -c app/__tests__/config/jest.config.js --ci --coverage --reporters=default --reporters=jest-junit",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:all": "npm run test && npm run test:e2e",
    "prepare": "node -e \"if(process.env.CI !== 'true' && process.env.VERCEL !== '1') require('husky').install()\"",
    "setup:local": "tsx scripts/setup-local-db.ts",
    "setup:test": "cross-env NODE_ENV=test tsx scripts/setup-test-db.ts",
    "setup:test-env": "node scripts/setup-test-env.js",
    "test:setup": "npm run setup:test && cross-env NODE_ENV=test jest -c app/__tests__/config/jest.config.js --runInBand",
    "test:db": "cross-env NODE_ENV=test concurrently \"node backend/server.js\" \"next dev\"",
    "test:db:setup": "powershell -Command \"npm run setup:test; if ($?) { npm run test:db }\"",
    "migrate:dev": "cross-env NODE_ENV=development tsx scripts/migrate.ts",
    "migrate:prod": "cross-env NODE_ENV=production tsx scripts/migrate.ts",
    "migrate:test": "cross-env NODE_ENV=test tsx scripts/migrate.ts",
    "seed:dev": "cross-env NODE_ENV=development tsx scripts/seed-dev-data.ts",
    "seed:prod": "cross-env NODE_ENV=production tsx scripts/seed-prod-initial.ts",
    "seed:test": "cross-env NODE_ENV=test tsx scripts/seed-test-data.ts",
    "dev:setup": "npm run setup:local && npm run migrate:dev && npm run seed:dev",
    "dev:fresh": "npm run dev:setup && npm run dev",
    "test:db:prod": "cross-env NODE_ENV=production tsx scripts/test-db-connection.ts",
    "prod:setup": "npm run migrate:prod && npm run seed:prod",
    "test:server": "cross-env NODE_ENV=test node backend/server.js",
    "backend": "NODE_ENV=production node backend/server.js",
    "backend:dev": "NODE_ENV=development node backend/server.js",
    "backend:test": "NODE_ENV=test node backend/server.js"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.12.0",
    "@dnd-kit/core": "latest",
    "@dnd-kit/sortable": "latest",
    "@dnd-kit/utilities": "latest",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-hover-card": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-menubar": "^1.1.4",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "latest",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
