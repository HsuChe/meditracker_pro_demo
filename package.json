    "@types/pg": "^8.11.11",
    "@types/react-datepicker": "^6.2.0",
    "@vercel/postgres": "^0.10.0",
    "autoprefixer": "^10.4.20",
    "axios": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "csv-parser": "^3.2.0",
    "date-fns": "^3.0.0",
    "dotenv": "^16.4.7",
    "embla-carousel-react": "8.5.1",
    "husky": "^8.0.3",
    "input-otp": "1.4.1",
    "lucide-react": "^0.454.0",
    "multer": "^1.4.5-lts.1",
    "next": "14.2.16",
    "next-themes": "latest",
    "papaparse": "^5.5.2",
    "pg": "^8.13.1",
    "react": "^18",
    "react-datepicker": "^8.0.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^18",
    "react-hook-form": "^7.54.1",
    "react-icons": "latest",
    "react-resizable-panels": "^2.1.7",
    "recharts": "latest",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.6",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@swc/jest": "^0.2.37",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/cypress": "^0.1.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "cypress": "^14.0.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.1.7",
    "express": "^4.21.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^15.4.3",
    "postcss": "^8",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
