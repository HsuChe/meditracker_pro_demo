{
  "name": "meditracker-pro-backend",
  "version": "1.0.0",
  "description": "Backend for MediTracker Pro application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "render-start": "node start.js",
    "dev": "nodemon server.js",
    "migrate": "node migrations/init.js",
    "postinstall": "npm run migrate",
    "test": "jest",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:operators": "jest filterController.test.js --watch",
    "db:setup": "ts-node scripts/index.ts setup",
    "db:list": "ts-node scripts/index.ts list",
    "db:describe": "ts-node scripts/index.ts describe",
    "db:inspect": "ts-node scripts/db/utils/inspect.ts",
    "db:compare": "ts-node scripts/db/utils/compare-schemas.ts",
    "db:migrate-neon": "ts-node scripts/migrate-neon.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "fs": "^0.0.1-security",
    "path": "^0.12.7",
    "pg": "^8.11.3",
    "pg-format": "^1.0.4"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.11",
    "@types/pg": "^8.11.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./tests/setup/jest.setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "routes/**/*.js",
      "utils/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
